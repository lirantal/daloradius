# Copy this file to .env before running Docker Compose.
# Replace every CHANGE_ME_... value with deployment-specific secrets.
#
# Secrets can be provided in two ways (priority order):
# 1. Docker Secrets: files in secrets/db/<name> (recommended for production)
# 2. Environment variables in .env (fallback, used if secret file is absent)
# See secrets/README.md for details.

# === Required (must be set, no fallback) ===
# These are fallbacks — Docker Secrets (secrets/db/) take priority at runtime.
# If using secrets, you can leave these commented out or with placeholder values.
MYSQL_PASSWORD=CHANGE_ME_RADIUS_DB_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_DB_PASSWORD
DEFAULT_CLIENT_SECRET=CHANGE_ME_RADIUS_SHARED_SECRET

# === Connection settings (overridable) ===
MYSQL_HOST=radius-mysql
MYSQL_PORT=3306
MYSQL_USER=radius
MYSQL_DATABASE=radius
MYSQL_WAIT_INTERVAL=5

# === FreeRADIUS ===
# FREERADIUS_SQL_TLS: disabled (default), require (enforce TLS), or enabled (opportunistic TLS)
FREERADIUS_SQL_TLS=disabled

# === Optional settings ===
TZ=Europe/Vienna
DALORADIUS_OPERATORS_BIND=127.0.0.1:8000
MYSQL_HEALTH_START_PERIOD=10m
MAIL_SMTPADDR=127.0.0.1
MAIL_PORT=25
MAIL_FROM=root@daloradius.example.com
MAIL_AUTH=
PASSWORD_MIN_LENGTH=
PASSWORD_MAX_LENGTH=
