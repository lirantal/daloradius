# Copy this file to .env before running Docker Compose.
# Replace every CHANGE_ME_... value with deployment-specific secrets.
#
# All compose files (root and standalone) use environment variables from .env.
# Docker Secrets (secrets/db/) are NOT wired into compose yet — they require
# additional setup. For now, set all values here and copy to .env.
#
# See secrets/README.md for future Docker Secrets support.

# === Required (must be set in .env) ===
MYSQL_PASSWORD=CHANGE_ME_RADIUS_DB_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_DB_PASSWORD
DEFAULT_CLIENT_SECRET=CHANGE_ME_RADIUS_SHARED_SECRET

# === Connection settings (overridable) ===
MYSQL_HOST=radius-mysql
MYSQL_PORT=3306
# MYSQL_HOST_PORT: host port for MariaDB (defaults to 3306, same as internal).
# Set a different value (e.g., 3307) to avoid conflicts with a local MariaDB.
# Internal service-to-service connections always use MYSQL_PORT (3306).
MYSQL_HOST_PORT=3306
MYSQL_USER=radius
MYSQL_DATABASE=radius
MYSQL_WAIT_INTERVAL=5

# === FreeRADIUS ===
# FREERADIUS_SQL_TLS: disabled (default), require (enforce TLS), or enabled (opportunistic TLS)
FREERADIUS_SQL_TLS=disabled

# === Optional settings ===
TZ=Europe/Vienna
DALORADIUS_OPERATORS_BIND=127.0.0.1:8000
MYSQL_HEALTH_START_PERIOD=10m
MAIL_SMTPADDR=127.0.0.1
MAIL_PORT=25
MAIL_FROM=root@daloradius.example.com
MAIL_AUTH=
PASSWORD_MIN_LENGTH=
PASSWORD_MAX_LENGTH=
