# Reference TLS template for MariaDB.
# The installer generates its own tls.cnf at docker/db/tls.cnf.
# This file is a static reference and is NOT modified by the installer.
# To enable TLS: set FREERADIUS_SQL_TLS=enabled|require in .env
# and run setup/install-docker-compose.sh.

[mysqld]
# SSL/TLS configuration
ssl-ca=/etc/mysql/certs/mysql_ca.pem
ssl-cert=/etc/mysql/certs/mysql_server.pem
ssl-key=/etc/mysql/certs/mysql_server.key.pem

# Optional: force secure connections (uncomment for production)
# require_secure_transport = ON
